package @@PACKAGE@@;
//@@share
import android.content.Intent;
import android.net.Uri;
import android.util.Base64;
import android.webkit.JavascriptInterface;
import android.webkit.WebView;
import android.widget.Toast;

import androidx.annotation.NonNull;
import androidx.core.content.FileProvider;
import androidx.webkit.JavaScriptReplyProxy;
import androidx.webkit.WebMessageCompat;
import androidx.webkit.WebViewCompat;
import androidx.webkit.WebViewFeature;

import org.json.JSONObject;

import java.io.File;
import java.io.FileOutputStream;
import java.util.Arrays;
import java.util.HashSet;
import java.util.Set;
//@@end
//@@print
import android.print.PrintAttributes;
import android.print.PrintDocumentAdapter;
import android.print.PrintManager;
import android.print.ShellPdfWriter;
import android.view.ViewGroup;
import android.webkit.WebViewClient;
//@@end

// tools/java/MainActivity.java.in — זהות המעטפת: הערכים שנבדלים בין האפליקציות, מהתצורה
public class MainActivity extends ShellActivity {

    @Override
    protected String appUrl() { return "@@URL@@"; }

    @Override
    protected String offlineLine() { return "@@OFFLINE@@"; }

    @Override
    protected String accentColor() { return "@@ACCENT@@"; }
//@@share

    // המקור היחיד שרשאי להגיע לגשר השיתוף — גשר על דף שנטען מרחוק נגיש לכל מי שמגיש את הדף.
    // נאכף פעמיים: רשימת ההיתר של הפלטפורמה ובדיקת המקור בתוך הגשר.
    // origin ולא URL — הנתיב אינו גבול האבטחה.
    private static final String APP_ORIGIN = "@@ORIGIN@@";
    private static final String APP_HOST = "@@HOST@@";
    private static final Set<String> ALLOWED_ORIGINS = new HashSet<>(Arrays.asList(APP_ORIGIN));

    private boolean legacyBridgeAttached = false;

    // ── גשר שיתוף, מוגבל למקור ──
    // addJavascriptInterface מוזרק לכל frame בכל דף בלי מושג מקור — לכן מועדף addWebMessageListener (WebView 88+), שבודק את רשימת ההיתר פר-frame.
    // במסלול הישן הממשק מחובר רק על המקור שלנו, וכל קריאה בודקת שוב את המארח החי ב-UI thread.
    @Override
    protected void installBridge() {
        if (WebViewFeature.isFeatureSupported(WebViewFeature.WEB_MESSAGE_LISTENER)) {
            WebViewCompat.addWebMessageListener(
                webView, "AndroidShareBridge", ALLOWED_ORIGINS,
                new WebViewCompat.WebMessageListener() {
                    @Override
                    public void onPostMessage(@NonNull WebView view, @NonNull WebMessageCompat message,
                                              @NonNull Uri sourceOrigin, boolean isMainFrame,
                                              @NonNull JavaScriptReplyProxy replyProxy) {
                        // הגנה כפולה: WebView כבר סינן לפי ALLOWED_ORIGINS.
                        if (!isMainFrame || !APP_ORIGIN.equals(String.valueOf(sourceOrigin))) return;
                        try {
                            JSONObject o = new JSONObject(String.valueOf(message.getData()));
                            shareFile(o.optString("data"), o.optString("mime"), o.optString("name"));
                        } catch (Exception e) {
                            toastUi("שגיאה בהכנת הקובץ לשיתוף");
                        }
                    }
                });
//@@print
            installPrint();
//@@end
        }
        // הממשק הישן אינו מחובר כאן — עוד לא נטען דף, וחיבור בלי תנאי הוא בדיוק מה שיש למנוע; הוא מחובר בניווט, כשהמקור ידוע.
    }

    @Override
    protected void onShellNavigation(String url) {
        if (WebViewFeature.isFeatureSupported(WebViewFeature.WEB_MESSAGE_LISTENER)) return;
        boolean ours = isAppOrigin(url);
        if (ours && !legacyBridgeAttached) {
            webView.addJavascriptInterface(new ShareBridge(), "AndroidShare");
            legacyBridgeAttached = true;
        } else if (!ours && legacyBridgeAttached) {
            webView.removeJavascriptInterface("AndroidShare");
            legacyBridgeAttached = false;
        }
    }

    // https ובדיוק המארח שלנו — גם http על אותו מארח אינו אנחנו.
    private static boolean isAppOrigin(String url) {
        if (url == null) return false;
        try {
            Uri u = Uri.parse(url);
            return "https".equals(u.getScheme()) && APP_HOST.equals(u.getHost());
        } catch (Exception e) {
            return false;
        }
    }

    // ── השיתוף עצמו ──
    // אין יעד קבוע — הבורר של המערכת בוחר; יעד קבוע היה שולח את הדוח לאפליקציה אחת בלבד.
    // הקובץ — תמונה, PDF או גיליון, והסיומת נגזרת מסוג התוכן: אפליקציה שמקבלת קובץ בסיומת שגויה אינה פותחת אותו.
    // name — שם הקובץ מהדף (גיליון התלמיד והחודש); ריק — הקידומת והשעה. תיקייה לכל שיתוף, כדי ששני קבצים באותו שם לא ידרסו.
    private void shareFile(final String base64Data, final String mimeType, final String name) {
        try {
            byte[] bytes = Base64.decode(base64Data, Base64.DEFAULT);
            File dir = new File(getCacheDir(), "shared");
            dir.mkdirs();
            final String mime = (mimeType == null || mimeType.isEmpty()) ? "image/jpeg" : mimeType;
            final String ext = "application/pdf".equals(mime) ? ".pdf"
                : "image/png".equals(mime) ? ".png"
                : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet".equals(mime) ? ".xlsx"
                : "text/csv".equals(mime) ? ".csv"
                : ".jpg";
            String base = name == null ? "" : name.replaceAll("[\\\\/:*?\"<>|\\p{Cntrl}]+", " ").trim();
            if (base.toLowerCase().endsWith(ext)) base = base.substring(0, base.length() - ext.length()).trim();
            if (base.length() > 120) base = base.substring(0, 120).trim();
            final File f;
            if (base.isEmpty()) {
                f = new File(dir, "@@FILEPREFIX@@" + System.currentTimeMillis() + ext);
            } else {
                File sub = new File(dir, String.valueOf(System.currentTimeMillis()));
                sub.mkdirs();
                f = new File(sub, base + ext);
            }
            FileOutputStream fos = new FileOutputStream(f);
            fos.write(bytes);
            fos.flush();
            fos.close();
            shareSaved(f, mime);
        } catch (Exception e) {
            toastUi("שגיאה בהכנת הקובץ לשיתוף");
        }
    }

    // קובץ שכבר נכתב במטמון «shared» — לבורר השיתוף של המערכת.
    private void shareSaved(final File f, final String mime) {
        final Uri uri;
        try {
            uri = FileProvider.getUriForFile(MainActivity.this, getPackageName() + ".fileprovider", f);
        } catch (Exception e) {
            toastUi("שגיאה בהכנת הקובץ לשיתוף");
            return;
        }
        runOnUiThread(new Runnable() {
            @Override
            public void run() {
                Intent send = new Intent(Intent.ACTION_SEND);
                send.setType(mime);
                send.putExtra(Intent.EXTRA_STREAM, uri);
                send.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);

                // createChooser בלי FLAG_ACTIVITY_NEW_TASK — המשתמש בוחר יעד בכל פעם, והחזרה מביאה אותו למעטפת.
                Intent toStart = Intent.createChooser(send, "@@CHOOSER@@");
                try {
                    startActivity(toStart);
                } catch (Exception e) {
                    Toast.makeText(MainActivity.this, "שגיאה בשיתוף", Toast.LENGTH_SHORT).show();
                }
            }
        });
    }

//@@print
    // ── גשר ההדפסה ──
    // מסמך מגיע כדף HTML שלם (גופנים ותמונות מוטמעים בו), נטען ב-WebView נסתר ומודפס לקובץ PDF — טקסט וקטורי, בלי חלון הדפסה; ומשם לשיתוף.
    // ה-WebView הנסתר מוחזק בשדה עד סוף הכתיבה — בלי הפניה הוא נאסף באמצע.
    private WebView printView;

    private void installPrint() {
        WebViewCompat.addWebMessageListener(
            webView, "AndroidPrintBridge", ALLOWED_ORIGINS,
            new WebViewCompat.WebMessageListener() {
                @Override
                public void onPostMessage(@NonNull WebView view, @NonNull WebMessageCompat message,
                                          @NonNull Uri sourceOrigin, boolean isMainFrame,
                                          @NonNull JavaScriptReplyProxy replyProxy) {
                    if (!isMainFrame || !APP_ORIGIN.equals(String.valueOf(sourceOrigin))) return;
                    try {
                        JSONObject o = new JSONObject(String.valueOf(message.getData()));
                        printHtml(o.optString("html"), o.optString("name"));
                    } catch (Exception e) {
                        toastUi("שגיאה בהכנת המסמך");
                    }
                }
            });
    }

    // המסמך נכתב תוך PRINT_MAX_MS, או שנפתח חלון ההדפסה של המערכת — לעולם לא «כלום».
    private static final long PRINT_MAX_MS = 15000;

    private void printHtml(final String html, final String name) {
        runOnUiThread(new Runnable() {
            @Override
            public void run() {
                if (printView != null) { toastUi("מסמך קודם עדיין בהכנה"); return; }
                final WebView pv = new WebView(MainActivity.this);
                printView = pv;
                pv.getSettings().setJavaScriptEnabled(false);
                // מחובר לחלון, שקוף ובגודל המסך — WebView שאינו מחובר אינו מתחייב לפריסה, והכתיבה עלולה לא להסתיים.
                pv.setAlpha(0f);
                ((ViewGroup) getWindow().getDecorView()).addView(pv,
                    new ViewGroup.LayoutParams(Math.max(1, webView.getWidth()), Math.max(1, webView.getHeight())));
                pv.setWebViewClient(new WebViewClient() {
                    private boolean started = false;
                    @Override
                    public void onPageFinished(WebView v, String url) {
                        if (started) return;
                        started = true;
                        // הגופנים המוטמעים מתפענחים אחרי סוף הטעינה — השהיה קצרה לפני ההדפסה.
                        v.postDelayed(new Runnable() {
                            @Override public void run() { writePdf(pv, name); }
                        }, 500);
                    }
                });
                pv.loadDataWithBaseURL(APP_ORIGIN + "/", html, "text/html", "utf-8", null);
            }
        });
    }

    private void printDone(WebView pv) {
        try { ((ViewGroup) getWindow().getDecorView()).removeView(pv); } catch (Exception e) { /* כבר הוסר */ }
        if (printView == pv) printView = null;
    }

    private void writePdf(final WebView pv, final String name) {
        String base = name == null ? "" : name.replaceAll("[\\\\/:*?\"<>|\\p{Cntrl}]+", " ").trim();
        if (base.toLowerCase().endsWith(".pdf")) base = base.substring(0, base.length() - 4).trim();
        if (base.length() > 120) base = base.substring(0, 120).trim();
        if (base.isEmpty()) base = "@@FILEPREFIX@@" + System.currentTimeMillis();
        final String title = base;
        final PrintAttributes attrs = new PrintAttributes.Builder()
            .setMediaSize(PrintAttributes.MediaSize.ISO_A4)
            .setResolution(new PrintAttributes.Resolution("pdf", "pdf", 600, 600))
            .setMinMargins(PrintAttributes.Margins.NO_MARGINS)
            .build();
        // הכרעה אחת בלבד — הכתיבה, הכשל או שעון העצר, הראשון שמגיע.
        final boolean[] settled = { false };
        final Runnable fallback = new Runnable() {
            @Override public void run() {
                if (settled[0]) return;
                settled[0] = true;
                toastUi("הכתיבה הישירה לא הצליחה — נפתח חלון ההדפסה");
                printDialog(pv, title, attrs);
            }
        };
        pv.postDelayed(fallback, PRINT_MAX_MS);
        try {
            File sub = new File(new File(getCacheDir(), "shared"), String.valueOf(System.currentTimeMillis()));
            sub.mkdirs();
            final File f = new File(sub, title + ".pdf");
            ShellPdfWriter.write(pv.createPrintDocumentAdapter(title), attrs, f,
                new Runnable() {
                    @Override public void run() {
                        runOnUiThread(new Runnable() {
                            @Override public void run() {
                                if (settled[0]) return;
                                settled[0] = true;
                                printDone(pv);
                                shareSaved(f, "application/pdf");
                            }
                        });
                    }
                },
                new Runnable() {
                    @Override public void run() { runOnUiThread(fallback); }
                });
        } catch (Throwable e) {
            runOnUiThread(fallback);
        }
    }

    // נפילה-חזרה: חלון ההדפסה של המערכת, ובו «שמירה כ-PDF».
    private void printDialog(final WebView pv, final String title, final PrintAttributes attrs) {
        runOnUiThread(new Runnable() {
            @Override
            public void run() {
                try {
                    PrintManager pm = (PrintManager) getSystemService(PRINT_SERVICE);
                    pm.print(title, pv.createPrintDocumentAdapter(title), attrs);
                } catch (Throwable e) {
                    toastUi("שגיאה בהכנת המסמך: " + e.getClass().getSimpleName());
                }
                printDone(pv);
            }
        });
    }
//@@end

    // מתודות JavascriptInterface רצות ב-binder thread פרטי — לכן ה-URL החי נקרא ב-UI thread לפני כל פעולה: זה המנעול השני.
    private class ShareBridge {
        @JavascriptInterface
        public void shareFile(final String base64Data, final String mimeType) {
            runOnUiThread(new Runnable() {
                @Override public void run() {
                    if (!isAppOrigin(webView.getUrl())) return;
                    MainActivity.this.shareFile(base64Data, mimeType, "");
                }
            });
        }
//@@print

        @JavascriptInterface
        public void printHtml(final String html, final String name) {
            runOnUiThread(new Runnable() {
                @Override public void run() {
                    if (!isAppOrigin(webView.getUrl())) return;
                    MainActivity.this.printHtml(html, name);
                }
            });
        }
//@@end
    }
//@@end
}
